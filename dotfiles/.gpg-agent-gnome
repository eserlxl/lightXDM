#!/bin/bash
#
# GPG agent session initialization for non-Plasma desktops
#
# This script is sourced from .xinitrc files to start gpg-agent,
# point SSH_AUTH_SOCK at it when enable-ssh-support is set, and refresh its tty.

# Start the GPG agent
gpg-connect-agent /bye

# Point SSH_AUTH_SOCK at gpg-agent when enable-ssh-support is set and refresh its tty
if grep -qs '^enable-ssh-support' ~/.gnupg/gpg-agent.conf; then
  export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
fi
gpg-connect-agent updatestartuptty /bye >/dev/null
