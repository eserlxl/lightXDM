#!/bin/bash
# .xinitrc for lightXDM: start LXDE with dbus and session vars
# shellcheck disable=SC1090

export DESKTOP_SESSION=lxde
export XDG_CURRENT_DESKTOP=LXDE
export XDG_SESSION_TYPE=x11

if command -v xrdb >/dev/null 2>&1; then
  [[ -f "${SYS_XRESOURCES:-/etc/X11/xinit/.Xresources}" ]] && xrdb -merge "${SYS_XRESOURCES:-/etc/X11/xinit/.Xresources}"
  [[ -f ~/.Xresources ]] && xrdb -merge ~/.Xresources
fi
if command -v xmodmap >/dev/null 2>&1; then
  [[ -f "${SYS_XMODMAP:-/etc/X11/xinit/.Xmodmap}" ]] && xmodmap "${SYS_XMODMAP:-/etc/X11/xinit/.Xmodmap}"
  [[ -f ~/.Xmodmap ]] && xmodmap ~/.Xmodmap
fi
[[ -f "${SYS_XPROFILE:-/etc/xprofile}" ]] && source "${SYS_XPROFILE:-/etc/xprofile}"
[[ -f ~/.xprofile ]] && source ~/.xprofile

if [ -d "${XINITRC_D:-/etc/X11/xinit/xinitrc.d}" ]; then
  for f in "${XINITRC_D:-/etc/X11/xinit/xinitrc.d}"/?*.sh; do
    [ -x "$f" ] && . "$f"
  done
  unset f
fi

# Source GPG agent integration for GNOME Keyring
if [[ -f ~/.gpg-agent-gnome ]]; then
  source ~/.gpg-agent-gnome
fi

# LXDE does not update the activation environment itself.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP DESKTOP_SESSION XDG_SESSION_TYPE ${SSH_AUTH_SOCK:+SSH_AUTH_SOCK}
fi

exec startlxde
